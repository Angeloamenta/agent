# Core
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
PAYLOAD_SECRET=replace-with-long-random-string

# Internal trigger auth (used by trigger script + /api/internal/run-pipeline)
CRON_SECRET=replace-with-long-random-string
PIPELINE_TRIGGER_URL=http://localhost:3000

# LLM (OpenAI / ChatGPT)
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-api-key
OPENAI_MODEL=gpt-4.1-mini

# Optional Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Pipeline gating (hours)
PIPELINE_MIN_HOURS=0
PIPELINE_MAX_HOURS=0

# Publishing
AUTO_PUBLISH=true

# Worker
WORKER_QUEUE=pipeline
WORKER_LIMIT=5
WORKER_POLL_MS=3000

# Scraping
SCRAPE_MAX_PER_FEED=5
SCRAPE_MAX_TOTAL=15
SCRAPE_TIMEOUT_MS=15000
SCRAPE_PER_DOMAIN_RPS=1
SCRAPE_USER_AGENT=payload-content-engine/1.0

# Writer
WRITER_SOURCE_LIMIT=3
